int* concatWithReverse(int* nums, int numsSize, int* returnSize) {
    
    int *ans = (int*)malloc(2 * numsSize * sizeof(int));

    *returnSize = 2 * numsSize;

    for (int i = 0; i < numsSize; i++) {
        ans[i] = nums[i];
        ans[i + numsSize] = nums[numsSize - i - 1];
    }

    return ans;
}
